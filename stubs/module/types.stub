/** Fields of the full form. */
export interface {{ Model }}FormData {
    {{ tsFormFields }}
    status: {{ Model }}Status;
    [key: string]: string | number | boolean;
}

/** Fields of the quick add / quick edit modal (mixed pattern). */
export interface {{ Model }}QuickFormData {
