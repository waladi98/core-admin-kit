import { type Paginated } from '@/types/user-management';

export type {{ Model }}Status = 'active' | 'inactive';

/** A {{ title }} as sent by `{{ Model }}Controller`. Generated by `php artisan make:module`. */
export interface {{ Model }} {
    id: number;
    {{ tsFields }}
    status: {{ Model }}Status;
    statusLabel: string;
    createdAt: string;
    updatedAt?: string;
}

export interface {{ Model }}FormOptions {
    statusOptions: SelectOption[];
    {{ tsOptionProps }}
}

export interface {{ Model }}IndexProps extends {{ Model }}FormOptions {
    {{ models }}: Paginated<{{ Model }}>;
    filters: {
        search: string | null;
        status: {{ Model }}Status | null;
        {{ tsSelectFilters }}
        /** Column name, prefixed with `-` for descending. */
        sort: string;
        perPage: number;
    };
    statusCounts: Record<'all' | {{ Model }}Status, number>;
}

export interface {{ Model }}EditProps extends {{ Model }}FormOptions {
