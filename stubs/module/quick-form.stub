import { Button, CurrencyInput, DatePicker, FormField, Input, Modal, ModalFooter, Select, Switch, Textarea } from '@/components/core';
import { __ } from '@/lib/i18n';
import { type {{ Model }}, type {{ Model }}FormOptions, type {{ Model }}QuickFormData } from '@/types/{{ slugSingular }}';
import { useForm } from '@inertiajs/react';
import { ArrowRight, Check } from 'lucide-react';
import { useEffect, type FormEventHandler } from 'react';

export interface {{ Model }}QuickFormProps extends {{ Model }}FormOptions {
    isOpen: boolean;
    onClose: () => void;
    /** The record to quick edit; null to quick add. */
    record: {{ Model }} | null;
}

function initialData(record: {{ Model }} | null): {{ Model }}QuickFormData {
    return {
        {{ tsQuickEmptyValues }}
        continue: false,
    };
}

/**
 * Quick add / quick edit modal on the {{ titles }} list. Validation errors stay in the modal;
 * it closes only after a successful save. Generated by `php artisan make:module`.
 */
export function {{ Model }}QuickForm({ isOpen, onClose, record, {{ optionPropNames }} }: {{ Model }}QuickFormProps) {
    const isEditing = record !== null;
    const { data, setData, errors, processing, post, patch, transform, setDefaults, clearErrors } = useForm<{{ Model }}QuickFormData>(initialData(record));

    // Load the chosen record (or an empty form) each time the modal opens.
    useEffect(() => {
        if (isOpen) {
            setDefaults(initialData(record));
            setData(initialData(record));
            clearErrors();
        }
        // eslint-disable-next-line react-hooks/exhaustive-deps -- reset only when the modal opens or the record changes
    }, [isOpen, record?.id]);

    const save = (shouldContinue: boolean) => {
        const options = { preserveScroll: true, preserveState: true, only: ['{{ models }}', 'statusCounts'], onSuccess: () => onClose() };

        if (record) {
            patch(route('{{ slug }}.quick-update', record.id), options);
        } else {
            transform((current) => ({ ...current, continue: shouldContinue }));
            post(route('{{ slug }}.store'), options);
        }
    };

    const handleSubmit: FormEventHandler = (event) => {
        event.preventDefault();
        save(false);
    };

    return (
        <Modal
            isOpen={isOpen}
            onClose={() => !processing && onClose()}
            title={isEditing ? 'Quick edit {{ title }}' : 'Add {{ title }}'}
            description={isEditing ? 'Change the main details. Open "Edit" for every field.' : 'Start with the main details; you can complete the rest later.'}
        >
            <form onSubmit={handleSubmit} className="grid gap-4 sm:grid-cols-2">
                {{ quickFormControls }}

                <ModalFooter className="sm:col-span-2">
                    <Button variant="secondary" onClick={onClose} disabled={processing}>
                        {__('Cancel')}
                    </Button>
                    {!isEditing && (
                        <Button variant="secondary" onClick={() => save(true)} disabled={processing}>
                            {__('Save & complete details')}
                            <ArrowRight />
                        </Button>
                    )}
                    <Button type="submit" isLoading={processing}>
                        {!processing && <Check />}
                        {isEditing ? __('Save changes') : __('Save')}
                    </Button>
                </ModalFooter>
            </form>
        </Modal>
    );
}