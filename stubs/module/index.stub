import { Can } from '@/components/admin/can';
import { ColumnToggle } from '@/components/admin/column-toggle';
import { DataTable, type DataTableColumn } from '@/components/admin/data-table';
{{#if mixed}}
import { {{ Model }}QuickForm } from '@/components/admin/{{ slugSingular }}-quick-form';
{{/if}}
import {
    Badge,
    Button,
    buttonVariants,
    Dropdown,
    DropdownContent,
    DropdownItem,
    DropdownLabel,
    DropdownSeparator,
    DropdownTrigger,
    FilterTabs,
    iconButtonVariants,
    Input,
    Pagination,
    Panel,
    useConfirm,
    type BreadcrumbEntry,
    type FilterTabOption,
} from '@/components/core';
import { usePermissions } from '@/hooks/use-can';
import { useColumnVisibility } from '@/hooks/use-column-visibility';
import { useTableQuery } from '@/hooks/use-table-query';
import AdminLayout from '@/layouts/admin-layout';
import { formatCurrency, formatDate, formatNumber } from '@/lib/format';
import { __ } from '@/lib/i18n';
import { cn } from '@/lib/utils';
import { type TableSort } from '@/types/table';
import { type {{ Model }}, type {{ Model }}IndexProps, type {{ Model }}Status } from '@/types/{{ slugSingular }}';
import { Head, Link, router } from '@inertiajs/react';
import { Check, Eye, Filter, {{ icon }}, LoaderCircle, MoreHorizontal, Pencil, PencilLine, Plus, Power, PowerOff, Search, Trash2 } from 'lucide-react';
import { useEffect, useState, type ReactNode } from 'react';

const breadcrumbs: BreadcrumbEntry[] = [{ title: '{{ Titles }}', href: '/{{ slug }}', icon: {{ icon }} }];

const columns: DataTableColumn<{{ Model }}>[] = [
    {
        key: '{{ titleField }}',
        header: '{{ titleFieldLabel }}',
        sortable: true,
        hideable: false,
        className: 'w-full min-w-48',
        cell: (record) =>
{{#if mixed}}
            <Link href={route('{{ slug }}.show', record.id)} prefetch className="text-ink font-medium hover:underline hover:underline-offset-4">
                {record.{{ titleFieldCamel }}}
            </Link>
{{/if}}
{{#if page}}
            <span className="text-ink font-medium">{record.{{ titleFieldCamel }}}</span>
{{/if}}
        ,
    },
    {{ tableColumns }}
    {
        key: 'status',
        header: 'Status',
        skeleton: 'badge',
        cell: (record) => (
            <Badge shape="pill" tone={record.status === 'active' ? 'success' : 'neutral'}>
                {record.statusLabel}
            </Badge>
        ),
    },
    { key: 'created_at', header: 'Added', sortable: true, cell: (record) => formatDate(record.createdAt) },
];

type StatusTab = 'all' | {{ Model }}Status;

/** Parses the server sort (`name` or `-name`) into the table sort state. */
function parseSort(sort: string): TableSort {
    return sort.startsWith('-') ? { key: sort.slice(1), direction: 'desc' } : { key: sort, direction: 'asc' };
}

/** {{ Titles }} list. Generated by `php artisan make:module`. */
export default function {{ Models }}Index({ {{ models }}, filters, statusCounts, ...options }: {{ Model }}IndexProps) {
    const can = usePermissions();
    const canEdit = can('{{ slug }}.update');
    const canDelete = can('{{ slug }}.delete');
    // The mixed pattern always has "View details"; the page pattern only shows actions the user may use.
    const hasRowActions = {{ hasRowActions }};
    const confirm = useConfirm();
    const [pendingIds, setPendingIds] = useState<string[]>([]);
    const columnVisibility = useColumnVisibility('{{ slug }}', columns);
{{#if mixed}}

    // Quick add (record null) or quick edit. The record is kept while the modal closes so its title does not flip.
    const [quickForm, setQuickForm] = useState<{ isOpen: boolean; record: {{ Model }} | null }>({ isOpen: false, record: null });
    const openQuickForm = (record: {{ Model }} | null) => setQuickForm({ isOpen: true, record });

    // "Add {{ title }}" from the command palette links to /{{ slug }}?create=1 and opens the modal straight away.
    useEffect(() => {
        if (new URLSearchParams(window.location.search).has('create') && can('{{ slug }}.create')) {
            openQuickForm(null);
        }
    }, [can]);
{{/if}}

    const table = useTableQuery<{ status: string | null{{ tsFilterType }} }>({
        url: route('{{ slug }}.index'),
        only: ['{{ models }}', 'filters', 'statusCounts'],
        initial: {
            search: filters.search ?? '',
            sort: parseSort(filters.sort),
            page: {{ models }}.currentPage,
            perPage: filters.perPage,
            filters: { status: filters.status{{ tsFilterInitial }} },
        },
    });

    const statusTabs: FilterTabOption<StatusTab>[] = [
        { value: 'all', label: 'All', count: statusCounts.all },
        { value: 'active', label: 'Active', count: statusCounts.active },
        { value: 'inactive', label: 'Inactive', count: statusCounts.inactive },
    ];

    /** Row requests (status, delete): the row shows as pending until the request ends. */
    const visitRow = (record: {{ Model }}, method: 'patch' | 'delete', url: string) => {
        const rowId = String(record.id);

        router.visit(url, {
            method,
            preserveScroll: true,
            preserveState: true,
            only: ['{{ models }}', 'statusCounts'],
            onStart: () => setPendingIds((ids) => [...ids, rowId]),
            onFinish: () => setPendingIds((ids) => ids.filter((id) => id !== rowId)),
        });
    };

    const deleteRecord = async (record: {{ Model }}) => {
        const confirmed = await confirm({
            title: 'Delete this {{ title }}?',
            description: __(':name will be removed. This cannot be undone.', { name: record.{{ titleFieldCamel }} }),
            confirmLabel: 'Delete',
            tone: 'danger',
        });

        if (confirmed) {
            visitRow(record, 'delete', route('{{ slug }}.destroy', record.id));
        }
    };

    const headerActions = (
        <>
            <Input
                type="search"
                placeholder={__('{{ searchPlaceholder }}')}
                aria-label={__('Search {{ titles }}')}
                leadingIcon={table.isSearching ? <LoaderCircle className="animate-spin" /> : <Search />}
                value={table.query.search}
                onChange={(event) => table.setSearch(event.target.value)}
                wrapperClassName="h-8 w-48 sm:w-64"
            />
{{#if hasFilter}}
            <Dropdown>
                <DropdownTrigger className={cn(buttonVariants({ variant: 'secondary', size: 'sm' }), table.query.filters.{{ filterField }} && 'border-brand')}>
                    <Filter />
                    {table.query.filters.{{ filterField }} ? options.{{ filterFieldCamel }}Options.find((option) => option.value === table.query.filters.{{ filterField }})?.label : __('Filter')}
                </DropdownTrigger>
                <DropdownContent>
                    <DropdownLabel>{__('{{ filterFieldLabel }}')}</DropdownLabel>
                    <DropdownItem onSelect={() => table.setFilter('{{ filterField }}', null)} icon={table.query.filters.{{ filterField }} === null ? <Check /> : <span className="size-4" />}>
                        {__('All')}
                    </DropdownItem>
                    <DropdownSeparator />
                    {options.{{ filterFieldCamel }}Options.map((option) => (
                        <DropdownItem
                            key={option.value}
                            onSelect={() => table.setFilter('{{ filterField }}', option.value)}
                            icon={table.query.filters.{{ filterField }} === option.value ? <Check /> : <span className="size-4" />}
                        >
                            {option.label}
                        </DropdownItem>
                    ))}
                </DropdownContent>
            </Dropdown>
{{/if}}
            <ColumnToggle visibility={columnVisibility} />
            <Can permission="{{ slug }}.create">
{{#if mixed}}
                <Button size="sm" onClick={() => openQuickForm(null)}>
                    <Plus />
                    {__('Add {{ title }}')}
                </Button>
{{/if}}
{{#if page}}
                <Link href={route('{{ slug }}.create')} prefetch className={buttonVariants({ size: 'sm' })}>
                    <Plus />
                    {__('Add {{ title }}')}
                </Link>
{{/if}}
            </Can>
        </>
    );

    return (
        <>
            <Head title={__('{{ Titles }}')} />

            <Panel fill>
                <Panel.Header title="{{ Titles }}" icon={ {{ icon }} } actions={headerActions} />
                <Panel.Toolbar>
                    <FilterTabs
                        label="Filter by status"
                        options={statusTabs}
                        value={(table.query.filters.status as StatusTab | null) ?? 'all'}
                        onChange={(status) => table.setFilter('status', status === 'all' ? null : status)}
                    />
                </Panel.Toolbar>
                <Panel.Body padding="none" className="flex flex-col">
                    <DataTable
                        stickyHeader
                        rows={ {{ models }}.data }
                        columns={columnVisibility.visibleColumns}
                        getRowId={(record) => String(record.id)}
                        rowNumberOffset={({{ models }}.currentPage - 1) * {{ models }}.perPage}
                        sort={table.query.sort}
                        onSortChange={table.setSort}
                        isLoading={table.isLoading}
                        pendingRowIds={pendingIds}
                        mobileCard={(record) => (
                            <div className="space-y-1.5">
                                <p className="text-ink truncate font-medium">{record.{{ titleFieldCamel }}}</p>
                                <div className="flex flex-wrap items-center gap-1.5">
                                    <Badge shape="pill" tone={record.status === 'active' ? 'success' : 'neutral'}>
                                        {record.statusLabel}
                                    </Badge>
                                    <span className="text-ink-subtle text-xs">{formatDate(record.createdAt)}</span>
                                </div>
                            </div>
                        )}
                        rowActions={
                            hasRowActions
                                ? (record) => (
                                      <Dropdown>
                                          <DropdownTrigger aria-label={__('Actions for :name', { name: record.{{ titleFieldCamel }} })} className={iconButtonVariants({ variant: 'ghost', size: 'sm' })}>
                                              <MoreHorizontal />
                                          </DropdownTrigger>
                                          <DropdownContent>
{{#if mixed}}
                                              <DropdownItem icon={<Eye />} href={route('{{ slug }}.show', record.id)}>
                                                  {__('View details')}
                                              </DropdownItem>
                                              {canEdit && (
                                                  <DropdownItem icon={<PencilLine />} onSelect={() => openQuickForm(record)}>
                                                      {__('Quick edit')}
                                                  </DropdownItem>
                                              )}
{{/if}}
                                              {canEdit && (
                                                  <DropdownItem icon={<Pencil />} href={route('{{ slug }}.edit', record.id)}>
                                                      {__('Edit')}
                                                  </DropdownItem>
                                              )}
{{#if mixed}}
                                              {canEdit && (
                                                  <DropdownItem
                                                      icon={record.status === 'active' ? <PowerOff /> : <Power />}
                                                      onSelect={() => visitRow(record, 'patch', route('{{ slug }}.toggle-status', record.id))}
                                                  >
                                                      {record.status === 'active' ? __('Deactivate') : __('Activate')}
                                                  </DropdownItem>
                                              )}
{{/if}}
                                              {canDelete && (
                                                  <>
                                                      <DropdownSeparator />
                                                      <DropdownItem icon={<Trash2 />} tone="danger" onSelect={() => deleteRecord(record)}>
                                                          {__('Delete')}
                                                      </DropdownItem>
                                                  </>
                                              )}
                                          </DropdownContent>
                                      </Dropdown>
                                  )
                                : undefined
                        }
                        emptyState={
                            <>
                                <p className="text-ink text-sm font-medium">{__('No {{ titles }} found')}</p>
                                <p className="text-ink-muted text-sm">{__('Try a different keyword or filter.')}</p>
                                {table.hasActiveFilters && (
                                    <Button variant="secondary" size="sm" className="mt-2" onClick={table.reset}>
                                        {__('Reset filters')}
                                    </Button>
                                )}
                            </>
                        }
                    />
                    <div className="border-line shrink-0 border-t px-3 py-2">
                        <Pagination
                            currentPage={ {{ models }}.currentPage }
                            lastPage={ {{ models }}.lastPage }
                            onPageChange={table.setPage}
                            loadingPage={table.loadingPage}
                            from={ {{ models }}.from }
                            to={ {{ models }}.to }
                            total={ {{ models }}.total }
                            perPage={table.query.perPage ?? {{ models }}.perPage}
                            onPerPageChange={table.setPerPage}
                        />
                    </div>
                </Panel.Body>
            </Panel>
{{#if mixed}}

            <{{ Model }}QuickForm
                isOpen={quickForm.isOpen}
                onClose={() => setQuickForm((current) => ({ ...current, isOpen: false }))}
                record={quickForm.record}
                {...options}
            />
{{/if}}
        </>
    );
}

/** Persistent layout: the shell stays mounted while navigating between pages. */
{{ Models }}Index.layout = (page: ReactNode) => <AdminLayout breadcrumbs={breadcrumbs}>{page}</AdminLayout>;