<?php

namespace App\Http\Controllers;

use App\Enums\RecordStatus;
{{ enumImports }}
use App\Http\Requests\{{ Model }}IndexRequest;
use App\Http\Requests\Quick{{ Model }}Request;
use App\Http\Requests\Update{{ Model }}Request;
use App\Models\ActivityLog;
use App\Models\{{ Model }};
use Illuminate\Database\Eloquent\Builder;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Gate;
use Illuminate\Support\Str;
use Inertia\Inertia;
use Inertia\Response;

/**
 * {{ Titles }}, mixed pattern (like Vendors):
 * - quick add and quick edit in a modal on the list (store, quickUpdate);
 * - the full form and the details are pages (edit/update, show).
 * Generated by `php artisan make:module`.
 */
class {{ Model }}Controller extends Controller
{
    public function index({{ Model }}IndexRequest $request): Response|RedirectResponse
    {
        Gate::authorize('viewAny', {{ Model }}::class);

        $sort = $request->sort();

        // Search and filters apply to both the table and the status tab counts.
        $filtered = {{ Model }}::query()
            ->when($request->search(), fn (Builder $query, string $search) => $query->where(
                fn (Builder $query) => {{ searchColumns }}
            ))
            {{ selectFilterQuery }};

        $statusCounts = (clone $filtered)->toBase()->selectRaw('status, count(*) as total')->groupBy('status')->pluck('total', 'status');

        $records = (clone $filtered)
            ->when($request->status(), fn (Builder $query, RecordStatus $status) => $query->where('status', $status))
            ->orderBy(ltrim($sort, '-'), Str::startsWith($sort, '-') ? 'desc' : 'asc')
            ->orderBy('id')
            ->paginate($request->perPage())
            ->withQueryString();

        // A page past the end (e.g. after deleting the last row of the last page) falls back to the last page.
        if ($records->isEmpty() && $records->currentPage() > 1) {
            return to_route('{{ slug }}.index', [...$request->query(), 'page' => $records->lastPage()]);
        }

        return Inertia::render('{{ slug }}/index', [
            '{{ models }}' => [
                'data' => $records->getCollection()->map(fn ({{ Model }} $record): array => $this->present($record))->all(),
                'currentPage' => $records->currentPage(),
                'lastPage' => $records->lastPage(),
                'perPage' => $records->perPage(),
                'from' => $records->firstItem(),
                'to' => $records->lastItem(),
                'total' => $records->total(),
            ],
            'filters' => [
                'search' => $request->search(),
                'status' => $request->status()?->value,
                {{ selectFilterProps }}
                'sort' => $sort,
                'perPage' => $request->perPage(),
            ],
            'statusCounts' => [
                'all' => (int) $statusCounts->sum(),
                ...collect(RecordStatus::cases())->mapWithKeys(fn (RecordStatus $status): array => [$status->value => (int) ($statusCounts[$status->value] ?? 0)])->all(),
            ],
            ...$this->formOptions(),
        ]);
    }

    /**
     * Quick add from the modal. "Save & complete details" (`continue`) opens the full edit page.
     */
    public function store(Quick{{ Model }}Request $request): RedirectResponse
    {
        $record = {{ Model }}::create($request->validated());

        if ($request->boolean('continue')) {
            return to_route('{{ slug }}.edit', $record)->withToast('success', __(':name was added. Complete the details below.', ['name' => $record->{{ titleField }}]));
        }

        return back()->withToast('success', __(':name was added.', ['name' => $record->{{ titleField }}]));
    }

    public function show({{ Model }} ${{ model }}): Response
    {
        Gate::authorize('view', ${{ model }});

        return Inertia::render('{{ slug }}/show', [
            '{{ model }}' => $this->present(${{ model }}),
            'history' => Inertia::defer(fn (): array => $this->history(${{ model }})),
        ]);
    }

    public function edit({{ Model }} ${{ model }}): Response
    {
        Gate::authorize('update', ${{ model }});

        return Inertia::render('{{ slug }}/edit', [
            '{{ model }}' => $this->present(${{ model }}),
            ...$this->formOptions(),
        ]);
    }

    /**
     * Full form (edit page). Goes to the detail page afterwards.
     */
    public function update(Update{{ Model }}Request $request, {{ Model }} ${{ model }}): RedirectResponse
    {
        ${{ model }}->update($request->validated());

        return to_route('{{ slug }}.show', ${{ model }})->withToast('success', __(':name was updated.', ['name' => ${{ model }}->{{ titleField }}]));
    }

    /**
     * Quick edit from the modal: only the modal fields change; the user stays on the list.
     */
    public function quickUpdate(Quick{{ Model }}Request $request, {{ Model }} ${{ model }}): RedirectResponse
    {
        ${{ model }}->update($request->validated());

        return back()->withToast('success', __(':name was updated.', ['name' => ${{ model }}->{{ titleField }}]));
    }

    /**
     * Switch between active and inactive straight from the table row.
     */
    public function toggleStatus({{ Model }} ${{ model }}): RedirectResponse
    {
        Gate::authorize('update', ${{ model }});

        ${{ model }}->update(['status' => ${{ model }}->status === RecordStatus::Active ? RecordStatus::Inactive : RecordStatus::Active]);

        return back()->withToast('success', ${{ model }}->status === RecordStatus::Active
            ? __(':name is active again.', ['name' => ${{ model }}->{{ titleField }}])
            : __(':name was deactivated.', ['name' => ${{ model }}->{{ titleField }}]));
    }

    public function destroy(Request $request, {{ Model }} ${{ model }}): RedirectResponse
    {
        Gate::authorize('delete', ${{ model }});

        ${{ model }}->delete();

        $toast = __(':name was deleted.', ['name' => ${{ model }}->{{ titleField }}]);

        // Deleting from the detail page cannot go "back" to a page that no longer exists.
        return $request->boolean('from_detail')
            ? to_route('{{ slug }}.index')->withToast('success', $toast)
            : back()->withToast('success', $toast);
    }

    /**
     * Options for the selects of the forms and filters.
     *
     * @return array<string, list<array{value: string, label: string}>>
     */
    private function formOptions(): array
    {
        return [
            'statusOptions' => RecordStatus::options(),
            {{ optionProps }}
        ];
    }

    /**
     * Audit trail entries about this record, newest first.
     *
     * @return list<array{id: int, description: string, causer: string|null, createdAt: string}>
     */
    private function history({{ Model }} ${{ model }}): array
    {
        return ActivityLog::query()
            ->with('causer')
            ->where('subject_type', ${{ model }}->getMorphClass())
            ->where('subject_id', ${{ model }}->getKey())
            ->latest('created_at')
            ->latest('id')
            ->limit(20)
            ->get()
            ->map(fn (ActivityLog $log): array => [
                'id' => $log->id,
                'description' => __($log->description),
                'causer' => $log->causer?->name,
                'createdAt' => $log->created_at->toIso8601String(),
            ])
            ->all();
    }

    /**
     * @return array<string, mixed>
     */
    private function present({{ Model }} $record): array
    {
        return [
            'id' => $record->id,
            {{ presentFields }}
            'status' => $record->status->value,
            'statusLabel' => $record->status->label(),
            'createdAt' => $record->created_at->toIso8601String(),
            'updatedAt' => $record->updated_at->toIso8601String(),
        ];
    }
}