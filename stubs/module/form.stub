import { Button, buttonVariants, CurrencyInput, DatePicker, FormActions, FormField, FormSection, Input, Select, Switch, Textarea } from '@/components/core';
import { __ } from '@/lib/i18n';
import { type {{ Model }}FormData, type {{ Model }}FormOptions } from '@/types/{{ slugSingular }}';
import { Link, useForm } from '@inertiajs/react';
import { Check, {{ icon }} } from 'lucide-react';
import { type FormEventHandler } from 'react';

export interface {{ Model }}FormProps extends {{ Model }}FormOptions {
    initialValues: {{ Model }}FormData;
    method: 'post' | 'put';
    action: string;
    submitLabel: string;
    cancelHref: string;
}

/**
 * Full {{ title }} form, used by the create/edit pages. Generated by `php artisan make:module`;
 * split the fields into more FormSections when the form grows.
 */
export function {{ Model }}Form({ initialValues, method, action, submitLabel, cancelHref, statusOptions, {{ optionPropNames }} }: {{ Model }}FormProps) {
    const { data, setData, submit, errors, processing } = useForm<{{ Model }}FormData>(initialValues);

    const handleSubmit: FormEventHandler = (event) => {
        event.preventDefault();
        submit(method, action, { preserveScroll: true });
    };

    return (
        <form onSubmit={handleSubmit} className="space-y-4">
            <FormSection icon={ {{ icon }} } title="{{ Title }} information" description="Fill in the details of the {{ title }}.">
                <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                        {{ formControls }}
                    <FormField label="Status" htmlFor="status" required hint="Inactive records are kept but hidden from daily use." error={errors.status}>
                        <Select
                            id="status"
                            options={statusOptions}
                            value={data.status}
                            onChange={(event) => setData('status', event.target.value as {{ Model }}FormData['status'])}
                            invalid={Boolean(errors.status)}
                        />
                    </FormField>
                </div>
            </FormSection>

            <FormActions sticky>
                <Link href={cancelHref} className={buttonVariants({ variant: 'secondary' })}>
                    {__('Cancel')}
                </Link>
                <Button type="submit" isLoading={processing}>
                    {!processing && <Check />}
                    {__(submitLabel)}
                </Button>
            </FormActions>
        </form>
    );
}