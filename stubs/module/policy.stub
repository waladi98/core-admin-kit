<?php

namespace App\Policies;

use App\Enums\Permission;
use App\Models\{{ Model }};
use App\Models\User;

/**
 * Admins pass every check through `Gate::before` (AppServiceProvider).
 * Give other roles the {{ slug }}.* permissions on the Roles & Permissions page.
 */
class {{ Model }}Policy
{
    public function viewAny(User $user): bool
    {
        return $user->can(Permission::{{ permissionCase }}View->value);
    }

    public function view(User $user, {{ Model }} ${{ model }}): bool
    {
        return $user->can(Permission::{{ permissionCase }}View->value);
    }

    public function create(User $user): bool
    {
        return $user->can(Permission::{{ permissionCase }}Create->value);
    }

    public function update(User $user, {{ Model }} ${{ model }}): bool
    {
        return $user->can(Permission::{{ permissionCase }}Update->value);
    }

    public function delete(User $user, {{ Model }} ${{ model }}): bool
    {
        return $user->can(Permission::{{ permissionCase }}Delete->value);
    }
}