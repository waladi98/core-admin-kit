import { Can } from '@/components/admin/can';
import { ListSkeleton } from '@/components/admin/skeletons';
import { TopbarActions } from '@/components/admin/topbar-actions';
import { Badge, Button, buttonVariants, FadeIn, Grid, Panel, useConfirm, type BreadcrumbEntry } from '@/components/core';
import AdminLayout from '@/layouts/admin-layout';
import { formatCurrency, formatDate, formatDateTime, formatNumber, formatRelative } from '@/lib/format';
import { __ } from '@/lib/i18n';
import { type {{ Model }}HistoryEntry, type {{ Model }}ShowProps } from '@/types/{{ slugSingular }}';
import { Deferred, Head, Link, router } from '@inertiajs/react';
import { History, {{ icon }}, Pencil, Trash2 } from 'lucide-react';
import { useState, type ReactElement, type ReactNode } from 'react';

function showBreadcrumbs(record: {{ Model }}ShowProps['{{ model }}']): BreadcrumbEntry[] {
    return [
        { title: '{{ Titles }}', href: '/{{ slug }}', icon: {{ icon }} },
        { title: record.{{ titleFieldCamel }}, href: route('{{ slug }}.show', record.id) },
    ];
}

/** Label/value pairs; empty values show a dash so the layout stays the same. */
function Details({ items }: { items: { label: string; value: ReactNode }[] }) {
    return (
        <dl className="grid gap-x-6 gap-y-3 sm:grid-cols-2">
            {items.map((item) => (
                <div key={item.label} className="min-w-0">
                    <dt className="text-ink-muted text-xs">{__(item.label)}</dt>
                    <dd className="text-ink mt-0.5 text-sm break-words">{item.value === null || item.value === '' || item.value === undefined ? '—' : item.value}</dd>
                </div>
            ))}
        </dl>
    );
}

function HistoryList({ entries }: { entries: {{ Model }}HistoryEntry[] }) {
    if (entries.length === 0) {
        return <p className="text-ink-muted text-sm">{__('No activity recorded yet.')}</p>;
    }

    return (
        <ol className="space-y-3">
            {entries.map((entry) => (
                <li key={entry.id} className="border-line border-l-2 pl-3">
                    <p className="text-ink text-sm">{entry.description}</p>
                    <p className="text-ink-subtle text-xs" title={formatDateTime(entry.createdAt)}>
                        {[entry.causer, formatRelative(entry.createdAt)].filter(Boolean).join(' · ')}
                    </p>
                </li>
            ))}
        </ol>
    );
}

/** {{ Title }} details: a real page with its own link. Generated by `php artisan make:module`. */
export default function Show{{ Model }}({ {{ model }}: record, history }: {{ Model }}ShowProps) {
    const confirm = useConfirm();
    const [isDeleting, setIsDeleting] = useState(false);

    const deleteRecord = async () => {
        const confirmed = await confirm({
            title: 'Delete this {{ title }}?',
            description: __(':name will be removed. This cannot be undone.', { name: record.{{ titleFieldCamel }} }),
            confirmLabel: 'Delete',
            tone: 'danger',
        });

        if (confirmed) {
            router.delete(route('{{ slug }}.destroy', record.id), {
                data: { from_detail: true },
                onStart: () => setIsDeleting(true),
                onFinish: () => setIsDeleting(false),
            });
        }
    };

    return (
        <>
            <Head title={record.{{ titleFieldCamel }}} />

            <TopbarActions>
                <Can permission="{{ slug }}.delete">
                    <Button variant="secondary" size="sm" onClick={deleteRecord} isLoading={isDeleting}>
                        {!isDeleting && <Trash2 />}
                        {__('Delete')}
                    </Button>
                </Can>
                <Can permission="{{ slug }}.update">
                    <Link href={route('{{ slug }}.edit', record.id)} prefetch className={buttonVariants({ size: 'sm' })}>
                        <Pencil />
                        {__('Edit')}
                    </Link>
                </Can>
            </TopbarActions>

            <Grid stagger>
                <Grid.Item span={{ base: 12, xl: 8 }}>
                    <Panel>
                        <Panel.Header
                            title="{{ Title }} information"
                            icon={ {{ icon }} }
                            actions={
                                <Badge shape="pill" tone={record.status === 'active' ? 'success' : 'neutral'}>
                                    {record.statusLabel}
                                </Badge>
                            }
                        />
                        <Panel.Body>
                            <Details
                                items={[
                                    {{ detailItems }}
                                    { label: 'Added', value: formatDateTime(record.createdAt) },
                                    { label: 'Last updated', value: record.updatedAt && formatDateTime(record.updatedAt) },
                                ]}
                            />
                        </Panel.Body>
                    </Panel>
                </Grid.Item>

                <Grid.Item span={{ base: 12, xl: 4 }}>
                    <Panel>
                        <Panel.Header title="History" icon={History} />
                        <Panel.Body className="scrollbar-thin max-h-[calc(100dvh-12rem)] overflow-y-auto">
                            <Deferred data="history" fallback={<ListSkeleton rows={4} />}>
                                <FadeIn variant="fade">
                                    <HistoryList entries={history ?? []} />
                                </FadeIn>
                            </Deferred>
                        </Panel.Body>
                    </Panel>
                </Grid.Item>
            </Grid>
        </>
    );
}

/** Persistent layout: the shell stays mounted while navigating between pages. */
Show{{ Model }}.layout = (page: ReactElement<{{ Model }}ShowProps>) => (
    <AdminLayout breadcrumbs={showBreadcrumbs(page.props.{{ model }})} title=":name" titleParams={{ name: page.props.{{ model }}.{{ titleFieldCamel }} }}>
        {page}
    </AdminLayout>
);